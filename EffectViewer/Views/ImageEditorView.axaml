<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EffectViewer.Controls"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.ImageEditorView"
             x:DataType="vm:ImageEditorViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
    <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Right"
            Background="Transparent">
        <MenuItem Header="_Layout">
          <MenuItem Header="_Properties"
                    Command="{Binding ToggleSidePanelCommand}"
                    IsChecked="{Binding IsSidePanelVisible, Mode=OneWay}"
                    ToggleType="CheckBox"/>
          <Separator/>
          <MenuItem Header="Dock Properties _Left"
                    Command="{Binding DockSidePanelLeftCommand}"
                    IsChecked="{Binding IsSidePanelOnLeft, Mode=OneWay}"
                    ToggleType="Radio"/>
          <MenuItem Header="Dock Properties _Right"
                    Command="{Binding DockSidePanelRightCommand}"
                    IsChecked="{Binding IsSidePanelOnRight, Mode=OneWay}"
                    ToggleType="Radio"/>
          <Separator/>
          <MenuItem Header="_Reset Editor Layout"
                    Command="{Binding ResetEditorLayoutCommand}"/>
        </MenuItem>
      </Menu>
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding AssetId}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
      </StackPanel>
    </DockPanel>

    <controls:DockablePanelView Grid.Row="1"
                                IsSidePanelVisible="{Binding IsSidePanelVisible}"
                                IsSidePanelOnLeft="{Binding IsSidePanelOnLeft}"
                                LayoutResetRevision="{Binding LayoutResetRevision}"
                                DefaultSidePanelWidth="320"
                                MinimumSidePanelWidth="220">
      <controls:DockablePanelView.PrimaryContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
          <controls:InteractiveEffectViewport Frame="{Binding PreviewFrame}"
                                              TextureSource="{Binding TextureSource}"/>
        </Border>
      </controls:DockablePanelView.PrimaryContent>

      <controls:DockablePanelView.SideContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="14">
              <TextBlock Text="Properties" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Metadata" FontWeight="SemiBold"/>
              <TextBlock Text="Rows"/>
              <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="128" Increment="1"/>
              <TextBlock Text="Cols"/>
              <NumericUpDown Value="{Binding Cols}" Minimum="1" Maximum="128" Increment="1"/>
              <Separator Margin="0,8"/>
              <TextBlock Text="Frame" FontWeight="SemiBold"/>
              <NumericUpDown Value="{Binding FrameIndex}"
                             Minimum="0"
                             Maximum="{Binding MaxFrameIndex}"
                             Increment="1"/>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                <TextBlock Text="Cells"/>
                <TextBlock Grid.Column="1" Text="{Binding CellCount}"/>
                <TextBlock Grid.Row="1" Text="Row"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentRow}"/>
                <TextBlock Grid.Row="2" Text="Col"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCol}"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </controls:DockablePanelView.SideContent>
    </controls:DockablePanelView>
  </Grid>
</UserControl>
