<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.WelcomeEditorView"
             x:DataType="vm:WelcomeEditorViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="28" RowSpacing="12">
    <TextBlock Text="{Binding Title}"
               FontSize="28"
               FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1"
               Text="{Binding Description}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
    <Border Grid.Row="2"
            Margin="0,16,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="20">
      <StackPanel Spacing="8">
        <TextBlock Text="Project layout"
                   FontSize="16"
                   FontWeight="SemiBold"/>
        <TextBlock Text="images / reanim / particles / trails / scripts"
                   FontFamily="{StaticResource CodeFontFamily}"
                   Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
