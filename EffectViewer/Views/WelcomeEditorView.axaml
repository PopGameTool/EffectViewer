<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.WelcomeEditorView"
             x:DataType="vm:WelcomeEditorViewModel">
  <ScrollViewer>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          Margin="28"
          RowSpacing="18">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Title}"
                   FontSize="28"
                   FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
      </StackPanel>

      <Border Grid.Row="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <Grid RowDefinitions="Auto,Auto"
              RowSpacing="12">
          <TextBlock Text="{Binding CreatePrompt}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <WrapPanel Grid.Row="1"
                     ItemSpacing="8"
                     LineSpacing="8">
            <Button Content="{DynamicResource Loc.Welcome.CreateProjectAction}"
                    MinWidth="110"
                    Command="{Binding CreateProjectCommand}"/>
            <Button Content="{DynamicResource Loc.Welcome.OpenProjectAction}"
                    MinWidth="110"
                    Command="{Binding OpenProjectCommand}"/>
            <Button Content="{DynamicResource Loc.Welcome.ImportResourceFolderAction}"
                    MinWidth="130"
                    Command="{Binding ImportResourceFolderCommand}"/>
            <Button Content="{DynamicResource Loc.Welcome.ImportResourcePakAction}"
                    MinWidth="110"
                    Command="{Binding ImportResourcePakCommand}"/>
          </WrapPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="4">
        <TextBlock Text="{Binding AuthorTitle}"
                   FontWeight="SemiBold"/>
        <ItemsControl Grid.Column="1"
                      ItemsSource="{Binding AuthorNames}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <StackPanel Grid.Row="3"
                  Spacing="8">
        <TextBlock Text="{Binding FeaturesTitle}"
                   FontSize="16"
                   FontWeight="SemiBold"/>
        <ItemsControl ItemsSource="{Binding FeatureDescriptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="8"
                    Margin="0,0,0,6">
                <TextBlock Text="-"
                           Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </Grid>
  </ScrollViewer>
</UserControl>
