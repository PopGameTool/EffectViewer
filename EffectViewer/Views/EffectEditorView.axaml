<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EffectViewer.Controls"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.EffectEditorView"
             x:DataType="vm:EffectEditorViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="FloatParameterTrackEditorTemplate"
                  DataType="vm:FloatParameterTrackViewModel">
      <StackPanel Spacing="8">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding Name}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="6">
            <Button Content="{DynamicResource Loc.Common.Reset}"
                    MinWidth="64"
                    Command="{Binding ResetCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Add}"
                    MinWidth="64"
                    Command="{Binding AddNodeCommand}"/>
          </StackPanel>
        </StackPanel>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Height="72">
          <controls:FloatParameterTrackPreview Track="{Binding}"/>
        </Border>
        <ItemsControl ItemsSource="{Binding Nodes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:FloatParameterTrackNodeViewModel">
              <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8"
                      Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Text="{DynamicResource Loc.Label.Time}"/>
                    <NumericUpDown Grid.Column="1"
                                   Value="{Binding TimePercent}"
                                   Minimum="0"
                                   Maximum="100"
                                   Increment="1"
                                   FormatString="0.###"/>
                    <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Label.Low}"/>
                    <NumericUpDown Grid.Row="1"
                                   Grid.Column="1"
                                   Value="{Binding LowValue}"
                                   Increment="0.1"
                                   FormatString="0.###"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource Loc.Label.High}"/>
                    <NumericUpDown Grid.Row="2"
                                   Grid.Column="1"
                                   Value="{Binding HighValue}"
                                   Increment="0.1"
                                   FormatString="0.###"/>
                  </Grid>
                  <TextBlock Text="{DynamicResource Loc.Label.Curve}"/>
                  <ComboBox ItemsSource="{Binding CurveOptions}"
                            SelectedItem="{Binding CurveType}"
                            HorizontalAlignment="Stretch"/>
                  <TextBlock Text="{DynamicResource Loc.Label.Distribution}"/>
                  <ComboBox ItemsSource="{Binding CurveOptions}"
                            SelectedItem="{Binding Distribution}"
                            HorizontalAlignment="Stretch"/>
                  <WrapPanel HorizontalAlignment="Right"
                             ItemSpacing="6"
                             LineSpacing="6">
                    <Button Content="{DynamicResource Loc.Common.Copy}"
                            MinWidth="64"
                            Command="{Binding CopyCommand}"/>
                    <Button Content="{DynamicResource Loc.Common.Remove}"
                            MinWidth="76"
                            Command="{Binding RemoveCommand}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ParticleFieldEditorTemplate"
                  DataType="vm:ParticleFieldViewModel">
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="8"
              Margin="0,0,0,8">
        <StackPanel Spacing="8">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding DisplayName}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
              <Button Content="{DynamicResource Loc.Common.Remove}"
                      MinWidth="76"
                      Command="{Binding RemoveCommand}"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{DynamicResource Loc.Label.FieldType}"/>
          <ComboBox ItemsSource="{Binding FieldTypeOptions}"
                    SelectedItem="{Binding FieldType}"
                    HorizontalAlignment="Stretch"/>
          <ContentControl Content="{Binding X}"
                          ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          <ContentControl Content="{Binding Y}"
                          ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ReanimTweenEditorTemplate"
                  DataType="vm:ReanimTweenViewModel">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding DisplayName}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="8"
              RowSpacing="8">
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.Track}"/>
            <TextBox Text="{Binding TrackNumberText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="TrackNumber"
                     LostFocus="ReanimTweenTextBox_LostFocus"
                     HorizontalContentAlignment="Right"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.TrackName}"/>
            <TextBox Text="{Binding TrackName, Mode=OneWay}"
                     IsReadOnly="True"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.StartFrame}"/>
            <TextBox Text="{Binding StartFrameNumberText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="StartFrameNumber"
                     LostFocus="ReanimTweenTextBox_LostFocus"
                     HorizontalContentAlignment="Right"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.EndFrame}"/>
            <TextBox Text="{Binding EndFrameNumberText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="EndFrameNumber"
                     LostFocus="ReanimTweenTextBox_LostFocus"
                     HorizontalContentAlignment="Right"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.AnchorX}"/>
            <TextBox Text="{Binding AnchorXText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="AnchorX"
                     LostFocus="ReanimTweenTextBox_LostFocus"
                     HorizontalContentAlignment="Right"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.AnchorY}"/>
            <TextBox Text="{Binding AnchorYText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="AnchorY"
                     LostFocus="ReanimTweenTextBox_LostFocus"
                     HorizontalContentAlignment="Right"/>
          </StackPanel>
        </Grid>
        <WrapPanel HorizontalAlignment="Right"
                   ItemSpacing="6"
                   LineSpacing="6">
          <Button Content="{DynamicResource Loc.Common.Keyframe}"
                  MinWidth="82"
                  IsEnabled="{Binding $parent[UserControl].DataContext.CanMakeSelectedReanimFrameKeyframe}"
                  Command="{Binding $parent[UserControl].DataContext.MakeSelectedReanimFrameKeyframeCommand}"/>
          <Button Content="{DynamicResource Loc.Common.Bake}"
                  MinWidth="64"
                  Command="{Binding $parent[UserControl].DataContext.BakeSelectedReanimTweenCommand}"/>
          <Button Content="{DynamicResource Loc.Common.Remove}"
                  MinWidth="76"
                  Command="{Binding $parent[UserControl].DataContext.RemoveReanimTweenCommand}"/>
        </WrapPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ParticleEmitterEditorTemplate"
                  DataType="vm:ParticleEmitterViewModel">
      <StackPanel Spacing="10" HorizontalAlignment="Stretch">
        <Expander Header="{DynamicResource Loc.Label.General}" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource Loc.Label.Name}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{DynamicResource Loc.Placeholder.EmitterName}"/>
            <TextBlock Text="{DynamicResource Loc.Label.ImageID}"/>
            <TextBox Text="{Binding ImageId, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{DynamicResource Loc.Placeholder.ImageResourceID}"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Loc.Label.ImageRow}"/>
                <NumericUpDown Value="{Binding ImageRow}"
                               Minimum="0"
                               Maximum="10000"
                               Increment="1"
                               FormatString="0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{DynamicResource Loc.Label.ImageCol}"/>
                <NumericUpDown Value="{Binding ImageCol}"
                               Minimum="0"
                               Maximum="10000"
                               Increment="1"
                               FormatString="0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock Text="{DynamicResource Loc.Label.ImageFrames}"/>
                <NumericUpDown Value="{Binding ImageFrames}"
                               Minimum="1"
                               Maximum="10000"
                               Increment="1"
                               FormatString="0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <TextBlock Text="{DynamicResource Loc.Label.EmitterType}"/>
                <ComboBox ItemsSource="{Binding EmitterTypeOptions}"
                          SelectedItem="{Binding EmitterType}"
                          HorizontalAlignment="Stretch"/>
              </StackPanel>
              <CheckBox Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Content="{DynamicResource Loc.Label.Animated}"
                        IsChecked="{Binding Animated}"/>
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.Flags}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <CheckBox Content="{DynamicResource Loc.Label.RandomLaunchSpin}" IsChecked="{Binding RandomLaunchSpin}"/>
            <CheckBox Content="{DynamicResource Loc.Label.AlignLaunchSpin}" IsChecked="{Binding AlignLaunchSpin}"/>
            <CheckBox Content="{DynamicResource Loc.Label.AlignToPixels}" IsChecked="{Binding AlignToPixels}"/>
            <CheckBox Content="{DynamicResource Loc.Label.SystemLoops}" IsChecked="{Binding SystemLoops}"/>
            <CheckBox Content="{DynamicResource Loc.Label.ParticleLoops}" IsChecked="{Binding ParticleLoops}"/>
            <CheckBox Content="{DynamicResource Loc.Label.ParticlesDontFollow}" IsChecked="{Binding ParticlesDontFollow}"/>
            <CheckBox Content="{DynamicResource Loc.Label.DieIfOverloaded}" IsChecked="{Binding DieIfOverloaded}"/>
            <CheckBox Content="{DynamicResource Loc.Label.Additive}" IsChecked="{Binding Additive}"/>
            <CheckBox Content="{DynamicResource Loc.Label.Fullscreen}" IsChecked="{Binding Fullscreen}"/>
            <CheckBox Content="{DynamicResource Loc.Label.SoftwareOnly}" IsChecked="{Binding SoftwareOnly}"/>
            <CheckBox Content="{DynamicResource Loc.Label.HardwareOnly}" IsChecked="{Binding HardwareOnly}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.Lifetime}" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding SystemDuration}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding CrossFadeDuration}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleDuration}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.Spawn}" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding SpawnRate}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SpawnMinActive}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SpawnMaxActive}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SpawnMaxLaunched}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.EmitterShape}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding EmitterRadius}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterOffsetX}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterOffsetY}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterBoxX}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterBoxY}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterSkewX}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterSkewY}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding EmitterPath}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.Launch}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding LaunchSpeed}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding LaunchAngle}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.SystemColor}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding SystemRed}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SystemGreen}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SystemBlue}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SystemAlpha}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding SystemBrightness}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.ParticleColor}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding ParticleRed}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleGreen}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleBlue}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleAlpha}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleBrightness}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.ParticleTransform}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding ParticleScale}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleStretch}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleSpinAngle}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ParticleSpinSpeed}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.Rendering}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding AnimationRate}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ClipTop}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ClipBottom}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ClipLeft}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding ClipRight}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.Collision}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="10">
            <ContentControl Content="{Binding CollisionReflect}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
            <ContentControl Content="{Binding CollisionSpin}"
                            ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.ParticleFields}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
              <Button Content="{DynamicResource Loc.Common.Add}"
                      MinWidth="58"
                      Command="{Binding AddParticleFieldCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ParticleFields}">
              <ItemsControl.ItemTemplate>
                <StaticResource ResourceKey="ParticleFieldEditorTemplate"/>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <Expander Header="{DynamicResource Loc.Label.SystemFields}" IsExpanded="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="6">
              <Button Content="{DynamicResource Loc.Common.Add}"
                      MinWidth="58"
                      Command="{Binding AddSystemFieldCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SystemFields}">
              <ItemsControl.ItemTemplate>
                <StaticResource ResourceKey="ParticleFieldEditorTemplate"/>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
    </DataTemplate>

  </UserControl.Resources>

  <Grid>
    <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
      <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Right"
              Background="Transparent">
          <MenuItem Header="{DynamicResource Loc.Menu.Animation}"
                    IsVisible="{Binding IsReanimEditor}">
            <MenuItem Header="{DynamicResource Loc.Menu.AddTrack}"
                      Command="{Binding AddReanimTrackCommand}"/>
            <MenuItem Header="{DynamicResource Loc.Menu.RemoveTrack}"
                      IsEnabled="{Binding CanRemoveReanimTrack}"
                      Command="{Binding RemoveReanimTrackCommand}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource Loc.Menu.AddFrame}"
                      Command="{Binding AddReanimFrameCommand}"/>
            <MenuItem Header="{DynamicResource Loc.Menu.RemoveFrame}"
                      IsEnabled="{Binding CanRemoveReanimFrame}"
                      Command="{Binding RemoveReanimFrameCommand}"/>
          </MenuItem>
          <MenuItem Header="{DynamicResource Loc.Menu.Layout}">
            <MenuItem Header="{DynamicResource Loc.Menu.Properties}"
                      Command="{Binding ToggleSidePanelCommand}"
                      IsChecked="{Binding IsSidePanelVisible, Mode=OneWay}"
                      ToggleType="CheckBox"/>
            <Separator/>
            <MenuItem Header="{DynamicResource Loc.Menu.DockPropertiesLeft}"
                      Command="{Binding DockSidePanelLeftCommand}"
                      IsChecked="{Binding IsSidePanelOnLeft, Mode=OneWay}"
                      ToggleType="Radio"/>
            <MenuItem Header="{DynamicResource Loc.Menu.DockPropertiesRight}"
                      Command="{Binding DockSidePanelRightCommand}"
                      IsChecked="{Binding IsSidePanelOnRight, Mode=OneWay}"
                      ToggleType="Radio"/>
            <Separator/>
            <MenuItem Header="{DynamicResource Loc.Menu.ResetEditorLayout}"
                      Command="{Binding ResetEditorLayoutCommand}"/>
          </MenuItem>
        </Menu>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding AssetId}"
                     FontSize="24"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Path}"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>

      <Grid x:Name="EditorContentGrid"
            Grid.Row="1"
            RowDefinitions="*,5,230">
        <controls:DockablePanelView Grid.Row="0"
                                    IsSidePanelVisible="{Binding IsSidePanelVisible}"
                                    IsSidePanelOnLeft="{Binding IsSidePanelOnLeft}"
                                    SidePanelWidth="{Binding SidePanelWidth, Mode=TwoWay}"
                                    CompactSidePanelHeight="{Binding CompactSidePanelHeight, Mode=TwoWay}"
                                    LayoutResetRevision="{Binding LayoutResetRevision}"
                                    DefaultSidePanelWidth="320"
                                    MinimumSidePanelWidth="260">
          <controls:DockablePanelView.PrimaryContent>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <controls:InteractiveEffectViewport Frame="{Binding PreviewFrame}"
                                                  FrameProvider="{Binding PreviewFrameProvider}"
                                                  TextureSource="{Binding TextureSource}"
                                                  DragHandler="{Binding}"/>
            </Border>
          </controls:DockablePanelView.PrimaryContent>

          <controls:DockablePanelView.SideContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="14" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource Loc.Label.Properties}" FontSize="16" FontWeight="SemiBold"/>

            <Expander Header="{DynamicResource Loc.Label.Structure}" IsExpanded="True" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{DynamicResource Loc.Label.ID}"/>
                  <TextBox Text="{Binding AssetId, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6" IsVisible="{Binding IsReanimEditor}">
                  <TextBlock Text="{DynamicResource Loc.Label.Tracks}"/>
                  <TextBlock Grid.Column="1" Text="{Binding ReanimTrackCount}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Label.Frames}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReanimFrameCount}"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource Loc.Label.FPS}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReanimFps}"/>
                  <TextBlock Grid.Row="3" Text="{DynamicResource Loc.Label.Duration}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReanimDurationSummary}"/>
                  <TextBlock Grid.Row="4" Text="{DynamicResource Loc.Label.Tweens}"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReanimTweenCount}"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" IsVisible="{Binding IsParticleEditor}">
                  <TextBlock Text="{DynamicResource Loc.Label.Emitters}"/>
                  <TextBlock Grid.Column="1" Text="{Binding ParticleEmitters.Count}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Label.Fields}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileSummary.FieldCount}"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" IsVisible="{Binding IsTrailEditor}">
                  <TextBlock Text="{DynamicResource Loc.Label.MaxPoints}"/>
                  <TextBlock Grid.Column="1" Text="{Binding TrailMaxPoints}"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource Loc.Label.MinDist}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TrailMinPointDistance}"/>
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Header="{DynamicResource Loc.Label.Transform}"
                      IsExpanded="True"
                      IsVisible="{Binding IsReanimEditor}"
                      IsEnabled="{Binding CanTransformSelectedReanimFrame}"
                      HorizontalAlignment="Stretch">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="8">
                  <StackPanel Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.TrackName}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.TrackName, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource Loc.Placeholder.TrackName}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.ImageID}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.ImageId, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource Loc.Placeholder.ImageResourceID}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.Font}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.FontId, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource Loc.Placeholder.FontID}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.Text}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.Text, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{DynamicResource Loc.Placeholder.Text}"/>
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.X}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.XText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="X"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.Y}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.YText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Y"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.ScaleX}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.ScaleXText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="ScaleX"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.ScaleY}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.ScaleYText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="ScaleY"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.SkewX}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.SkewXText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="SkewX"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.SkewY}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.SkewYText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="SkewY"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Row="3" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.Frame}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.FrameText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Frame"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource Loc.Label.Alpha}"/>
                    <TextBox Text="{Binding ReanimTransformDialog.AlphaText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Alpha"
                             LostFocus="ReanimTransformTextBox_LostFocus"
                             HorizontalContentAlignment="Right"/>
                  </StackPanel>
                  <CheckBox Grid.Row="4"
                            Grid.ColumnSpan="2"
                            Content="{DynamicResource Loc.Label.Visible}"
                            IsChecked="{Binding ReanimTransformDialog.Visible}"/>
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Header="{DynamicResource Loc.Label.Tweens}"
                      IsExpanded="True"
                      IsVisible="{Binding IsReanimEditor}"
                      HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <WrapPanel HorizontalAlignment="Right"
                           ItemSpacing="6"
                           LineSpacing="6">
                  <Button Content="{DynamicResource Loc.Common.Detect}"
                          MinWidth="64"
                          Command="{Binding RecognizeReanimTweensCommand}"/>
                  <Button Content="{DynamicResource Loc.Common.Add}"
                          MinWidth="58"
                          IsEnabled="{Binding CanEditReanimTweens}"
                          Command="{Binding AddReanimTweenCommand}"/>
                  <Button Content="{DynamicResource Loc.Common.BakeAll}"
                          MinWidth="78"
                          IsEnabled="{Binding HasReanimTweenMetadata}"
                          Command="{Binding BakeAllReanimTweensCommand}"/>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Loc.Label.NoTweens}"
                           IsVisible="{Binding HasNoReanimTweenMetadata}"
                           Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
                <ContentControl Content="{Binding SelectedReanimTween}"
                                ContentTemplate="{StaticResource ReanimTweenEditorTemplate}"/>
              </StackPanel>
            </Expander>

            <Expander Header="{DynamicResource Loc.Label.Definition}"
                      IsExpanded="True"
                      IsVisible="{Binding HasParticleControls}"
                      HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <StackPanel Spacing="6">
                  <ComboBox ItemsSource="{Binding ParticleEmitters}"
                            SelectedItem="{Binding SelectedParticleEmitter}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:ParticleEmitterViewModel">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayName}"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Detail}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Spacing="6">
                    <Button Content="{DynamicResource Loc.Common.Add}"
                            MinWidth="58"
                            Command="{Binding AddParticleEmitterCommand}"/>
                    <Button Content="{DynamicResource Loc.Common.Remove}"
                            MinWidth="76"
                            IsEnabled="{Binding CanRemoveParticleEmitter}"
                            Command="{Binding RemoveParticleEmitterCommand}"/>
                  </StackPanel>
                </StackPanel>
                <ContentControl Content="{Binding SelectedParticleEmitter}"
                                ContentTemplate="{StaticResource ParticleEmitterEditorTemplate}"/>
                <TextBlock Text="{Binding ParticleDefinitionError}"
                           IsVisible="{Binding HasParticleDefinitionError}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
              </StackPanel>
            </Expander>

            <Expander Header="{DynamicResource Loc.Label.Definition}"
                      IsExpanded="True"
                      IsVisible="{Binding HasTrailControls}"
                      HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.Label.ImageID}"/>
                <TextBox Text="{Binding TrailImageId, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="{DynamicResource Loc.Placeholder.ImageResourceID}"/>
                <TextBlock Text="{DynamicResource Loc.Label.MaxPoints}"/>
                <NumericUpDown Value="{Binding TrailMaxPoints}"
                               Minimum="2"
                               Maximum="20"
                               Increment="1"/>
                <TextBlock Text="{DynamicResource Loc.Label.MinDist}"/>
                <NumericUpDown Value="{Binding TrailMinPointDistance}"
                               Minimum="0"
                               Maximum="10000"
                               Increment="1"
                               FormatString="0.###"/>
                <CheckBox Content="{DynamicResource Loc.Label.Loops}"
                          IsChecked="{Binding TrailLoops}"/>
                <ContentControl Content="{Binding TrailWidthOverLength}"
                                ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
                <ContentControl Content="{Binding TrailWidthOverTime}"
                                ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
                <ContentControl Content="{Binding TrailAlphaOverLength}"
                                ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
                <ContentControl Content="{Binding TrailAlphaOverTime}"
                                ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
                <ContentControl Content="{Binding TrailDuration}"
                                ContentTemplate="{StaticResource FloatParameterTrackEditorTemplate}"/>
                <TextBlock Text="{Binding TrailDefinitionError}"
                           IsVisible="{Binding HasTrailDefinitionError}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
              </StackPanel>
            </Expander>

            <Expander Header="{DynamicResource Loc.Label.ImageReferences}" IsExpanded="False" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.Label.References}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ImageReferenceSummary}" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Loc.Label.Resolved}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResolvedImageReferenceSummary}" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Loc.Label.Missing}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding MissingImageSummary}" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>

            <Expander Header="{DynamicResource Loc.Label.Errors}" IsExpanded="False" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding FileSummary.Error}" TextWrapping="Wrap"/>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
        </controls:DockablePanelView.SideContent>
      </controls:DockablePanelView>
        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Classes="layout-splitter horizontal-splitter"
                      IsVisible="{Binding HasReanimControls}"/>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasReanimControls}">
          <Grid RowDefinitions="Auto,*"
                Margin="10"
                RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
              <TextBlock Text="{DynamicResource Loc.Label.Timeline}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <ScrollViewer Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                  <ComboBox ItemsSource="{Binding ReanimLayers}"
                            SelectedItem="{Binding SelectedReanimLayer}"
                            Width="150"/>
                  <TextBlock Text="{DynamicResource Loc.Label.FPS}"
                             VerticalAlignment="Center"/>
                  <NumericUpDown Value="{Binding ReanimFps}"
                                 Width="112"
                                 Minimum="1"
                                 Maximum="240"
                                 Increment="1"
                                 FormatString="0.###"/>
                  <CheckBox Content="{DynamicResource Loc.Label.Play}"
                            IsChecked="{Binding ReanimIsPlaying}"
                            VerticalAlignment="Center"/>
                  <CheckBox Content="{DynamicResource Loc.Label.FreeTransform}"
                            IsChecked="{Binding IsViewportFreeTransformEnabled}"
                            IsEnabled="{Binding CanTransformSelectedReanimFrame}"
                            VerticalAlignment="Center"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <controls:ReanimTimelineControl Editor="{Binding}"/>
            </ScrollViewer>
          </Grid>
        </Border>
    </Grid>
    </Grid>
  </Grid>
</UserControl>
