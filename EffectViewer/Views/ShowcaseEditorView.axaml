<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EffectViewer.Controls"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.ShowcaseEditorView"
             x:DataType="vm:ShowcaseEditorViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
    <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Right"
            Background="Transparent">
        <MenuItem Header="{DynamicResource Loc.Menu.Layout}">
          <MenuItem Header="{DynamicResource Loc.Menu.ScriptPanel}"
                    Command="{Binding ToggleSidePanelCommand}"
                    IsChecked="{Binding IsSidePanelVisible, Mode=OneWay}"
                    ToggleType="CheckBox"/>
          <Separator/>
          <MenuItem Header="{DynamicResource Loc.Menu.DockScriptPanelLeft}"
                    Command="{Binding DockSidePanelLeftCommand}"
                    IsChecked="{Binding IsSidePanelOnLeft, Mode=OneWay}"
                    ToggleType="Radio"/>
          <MenuItem Header="{DynamicResource Loc.Menu.DockScriptPanelRight}"
                    Command="{Binding DockSidePanelRightCommand}"
                    IsChecked="{Binding IsSidePanelOnRight, Mode=OneWay}"
                    ToggleType="Radio"/>
          <Separator/>
          <MenuItem Header="{DynamicResource Loc.Menu.ResetEditorLayout}"
                    Command="{Binding ResetEditorLayoutCommand}"/>
        </MenuItem>
      </Menu>
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DisplayAssetId}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{Binding DisplayPath}"
                   Foreground="{DynamicResource TextControlPlaceholderForeground}"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DockPanel>

    <controls:DockablePanelView Grid.Row="1"
                                IsSidePanelVisible="{Binding IsSidePanelVisible}"
                                IsSidePanelOnLeft="{Binding IsSidePanelOnLeft}"
                                SidePanelWidth="{Binding SidePanelWidth, Mode=TwoWay}"
                                CompactSidePanelHeight="{Binding CompactSidePanelHeight, Mode=TwoWay}"
                                LayoutResetRevision="{Binding LayoutResetRevision}"
                                DefaultSidePanelWidth="360"
                                MinimumSidePanelWidth="300">
      <controls:DockablePanelView.PrimaryContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <controls:InteractiveEffectViewport Frame="{Binding PreviewFrame}"
                                              FrameProvider="{Binding PreviewFrameProvider}"
                                              TextureSource="{Binding TextureSource}"/>
        </Border>
      </controls:DockablePanelView.PrimaryContent>

      <controls:DockablePanelView.SideContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
        <Grid RowDefinitions="Auto,*,5,140" RowSpacing="10">
          <Button Content="{DynamicResource Loc.Common.Run}"
                  Command="{Binding RunScriptCommand}"
                  HorizontalAlignment="Right"
                  MinWidth="92"/>

          <Border Grid.Row="1"
                  MinHeight="160"
                  Background="{DynamicResource TextControlBackground}"
                  BorderBrush="{DynamicResource TextControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <Grid>
              <TextBox x:Name="ScriptEditor"
                       Padding="8"
                       FontFamily="{StaticResource CodeFontFamily}"
                       FontSize="14"
                       AcceptsReturn="True"
                       AcceptsTab="True"
                       TextWrapping="NoWrap"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              <Border x:Name="InlineCompletionHost"
                      ZIndex="10"
                      IsVisible="False"
                      Margin="8"
                      MaxHeight="220"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Background="{DynamicResource TextControlBackground}"
                      BorderBrush="{DynamicResource TextControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <ListBox x:Name="InlineCompletionList"
                         MaxHeight="220">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="MinHeight" Value="0"/>
                      <Setter Property="Padding" Value="0"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShowcaseCompletionItem">
                      <TextBlock Text="{Binding DisplayText}"
                                 Padding="10,0"
                                 TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>
          </Border>

          <GridSplitter Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        Classes="layout-splitter horizontal-splitter"/>
          <ListBox Grid.Row="3"
                   ItemsSource="{Binding Logs}"
                   SelectedItem="{Binding SelectedLog}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ShowcaseLogEntry">
                <TextBlock Text="{Binding Summary}"
                           TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      </controls:DockablePanelView.SideContent>
    </controls:DockablePanelView>
  </Grid>
</UserControl>
