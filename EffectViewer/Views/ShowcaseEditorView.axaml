<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EffectViewer.Controls"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.ShowcaseEditorView"
             x:DataType="vm:ShowcaseEditorViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
    <DockPanel LastChildFill="True">
      <Menu DockPanel.Dock="Right"
            Background="Transparent">
        <MenuItem Header="{DynamicResource Loc.Menu.Layout}">
          <MenuItem Header="{DynamicResource Loc.Menu.ScriptPanel}"
                    Command="{Binding ToggleSidePanelCommand}"
                    IsChecked="{Binding IsSidePanelVisible, Mode=OneWay}"
                    ToggleType="CheckBox"/>
          <Separator/>
          <MenuItem Header="{DynamicResource Loc.Menu.DockScriptPanelLeft}"
                    Command="{Binding DockSidePanelLeftCommand}"
                    IsChecked="{Binding IsSidePanelOnLeft, Mode=OneWay}"
                    ToggleType="Radio"/>
          <MenuItem Header="{DynamicResource Loc.Menu.DockScriptPanelRight}"
                    Command="{Binding DockSidePanelRightCommand}"
                    IsChecked="{Binding IsSidePanelOnRight, Mode=OneWay}"
                    ToggleType="Radio"/>
          <Separator/>
          <MenuItem Header="{DynamicResource Loc.Menu.ResetEditorLayout}"
                    Command="{Binding ResetEditorLayoutCommand}"/>
        </MenuItem>
      </Menu>
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DisplayAssetId}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
      </StackPanel>
    </DockPanel>

    <controls:DockablePanelView Grid.Row="1"
                                IsSidePanelVisible="{Binding IsSidePanelVisible}"
                                IsSidePanelOnLeft="{Binding IsSidePanelOnLeft}"
                                LayoutResetRevision="{Binding LayoutResetRevision}"
                                DefaultSidePanelWidth="360"
                                MinimumSidePanelWidth="300">
      <controls:DockablePanelView.PrimaryContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <controls:InteractiveEffectViewport Frame="{Binding PreviewFrame}"
                                              FrameProvider="{Binding PreviewFrameProvider}"
                                              TextureSource="{Binding TextureSource}"/>
        </Border>
      </controls:DockablePanelView.PrimaryContent>

      <controls:DockablePanelView.SideContent>
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,5,120" RowSpacing="10">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource Loc.Common.Run}"
                    Command="{Binding RunScriptCommand}"
                    MinWidth="92"/>
            <TextBlock Text="{DynamicResource Loc.Label.Script}" FontSize="16" FontWeight="SemiBold"/>
          </DockPanel>

          <TextBox Grid.Row="1"
                   Text="{Binding ScriptText}"
                   AcceptsReturn="True"
                   FontFamily="{StaticResource CodeFontFamily}"
                   FontSize="14"
                   TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>

          <TextBlock Grid.Row="2" Text="{Binding Status}" FontWeight="SemiBold"/>
          <GridSplitter Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ResizeDirection="Rows"
                        Classes="layout-splitter horizontal-splitter"/>
          <Grid Grid.Row="4" ColumnDefinitions="*,5,*">
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
              <TextBlock Text="{DynamicResource Loc.Label.Objects}" FontWeight="SemiBold"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding SceneObjects}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Id}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          Classes="layout-splitter vertical-splitter"/>
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,72" RowSpacing="4">
              <TextBlock Text="{DynamicResource Loc.Label.Logs}" FontWeight="SemiBold"/>
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding Logs}"
                       SelectedItem="{Binding SelectedLog}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShowcaseLogEntry">
                    <TextBlock Text="{Binding Summary}"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2"
                         Text="{DynamicResource Loc.Label.Details}"
                         FontWeight="SemiBold"/>
              <TextBox Grid.Row="3"
                       Text="{Binding SelectedLogDetail}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="{StaticResource CodeFontFamily}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      </controls:DockablePanelView.SideContent>
    </controls:DockablePanelView>
  </Grid>
</UserControl>
