<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:EffectViewer.Controls"
             xmlns:vm="using:EffectViewer.ViewModels"
             x:Class="EffectViewer.Views.ShowcaseEditorView"
             x:DataType="vm:ShowcaseEditorViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="16">
    <DockPanel LastChildFill="True">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding AssetId}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="16">
      <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <controls:InteractiveEffectViewport Frame="{Binding PreviewFrame}"
                                            FrameProvider="{Binding PreviewFrameProvider}"
                                            TextureSource="{Binding TextureSource}"/>
      </Border>

      <Border Grid.Column="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,120" RowSpacing="10">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Run"
                    Command="{Binding RunScriptCommand}"
                    MinWidth="92"/>
            <TextBlock Text="Script" FontSize="16" FontWeight="SemiBold"/>
          </DockPanel>

          <TextBox Grid.Row="1"
                   Text="{Binding ScriptText}"
                   AcceptsReturn="True"
                   FontFamily="{StaticResource CodeFontFamily}"
                   FontSize="14"
                   TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"/>

          <TextBlock Grid.Row="2" Text="{Binding Status}" FontWeight="SemiBold"/>
          <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
              <TextBlock Text="Objects" FontWeight="SemiBold"/>
              <ListBox Grid.Row="1" ItemsSource="{Binding SceneObjects}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Id}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,72" RowSpacing="4">
              <TextBlock Text="Logs" FontWeight="SemiBold"/>
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding Logs}"
                       SelectedItem="{Binding SelectedLog}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShowcaseLogEntry">
                    <TextBlock Text="{Binding Summary}"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2"
                         Text="Details"
                         FontWeight="SemiBold"/>
              <TextBox Grid.Row="3"
                       Text="{Binding SelectedLogDetail}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       FontFamily="{StaticResource CodeFontFamily}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
