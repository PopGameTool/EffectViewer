<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EffectViewer.ViewModels"
             xmlns:input="using:Avalonia.Input"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="760"
             Focusable="True"
             IsTabStop="False"
             x:Class="EffectViewer.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
      <DataTemplate x:Key="ProjectExplorerItemTemplate"
                    DataType="vm:ProjectExplorerItemViewModel">
        <Border Background="Transparent"
                MinHeight="24">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource Loc.Menu.DeleteResource}"
                        Command="{Binding $parent[UserControl].DataContext.ShowDeleteResourceDialogCommand}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsSelectable}"/>
            </ContextMenu>
          </Border.ContextMenu>
          <Grid ColumnDefinitions="Auto,Auto,*"
                VerticalAlignment="Center">
            <Border Width="{Binding Indent}"/>
            <Button Grid.Column="1"
                    Classes="project-tree-disclosure"
                    Content="{Binding DisclosureText}"
                    Command="{Binding $parent[UserControl].DataContext.ToggleProjectExplorerItemCommand}"
                    CommandParameter="{Binding}"
                    IsVisible="{Binding CanExpand}"
                    IsEnabled="{Binding CanExpand}"/>
            <TextBlock Grid.Column="2"
                       Text="{Binding Title}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"/>
          </Grid>
        </Border>
      </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
      <Style Selector="Border.document-tab.selected">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
      </Style>
      <Style Selector="Border.document-tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
      </Style>
      <Style Selector="Border.document-tab.pinned">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
      </Style>
      <Style Selector="Border.document-tab.dragging">
        <Setter Property="Opacity" Value="0.55"/>
      </Style>
      <Style Selector="Border.document-tab.drop-before">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="3,1,1,0"/>
      </Style>
      <Style Selector="Border.document-tab.drop-after">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="1,1,3,0"/>
      </Style>
      <Style Selector="Border.document-tab-preview">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Opacity" Value="0.92"/>
      </Style>
      <Style Selector="TextBlock.document-tab-title.selected">
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style Selector="ListBox.project-tree-list">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
      </Style>
      <Style Selector="ListBox.project-tree-list ListBoxItem">
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      </Style>
      <Style Selector="Button.project-tree-disclosure">
        <Setter Property="Width" Value="20"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>
      <Style Selector="Button.tab-strip-button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style Selector="Button.compact-project-explorer-button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style Selector="Button.tab-close-button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style Selector="Border.tab-kind-badge">
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
      </Style>
      <Style Selector="TextBlock.tab-kind-badge-text">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style Selector="Border.tab-pin-badge">
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
      </Style>
      <Style Selector="TextBlock.tab-pin-badge-text">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>
      <Style Selector="Border.project-explorer-panel.drag-over">
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Style>
      <Style Selector="TextBox.project-tree-search">
        <Setter Property="MinHeight" Value="30"/>
      </Style>
    </UserControl.Styles>

    <UserControl.KeyBindings>
      <KeyBinding Gesture="Meta+Shift+N"
                  Command="{Binding ShowNewProjectDialogCommand}"/>
      <KeyBinding Gesture="Meta+O"
                  Command="{Binding ShowOpenProjectDialogCommand}"/>
      <KeyBinding Gesture="Meta+S"
                  Command="{Binding SaveFileCommand}"/>
      <KeyBinding Gesture="Meta+Alt+S"
                  Command="{Binding SaveProjectCommand}"/>
      <KeyBinding Gesture="Meta+Shift+S"
                  Command="{Binding SaveAllEditorsCommand}"/>
      <KeyBinding Gesture="Meta+N"
                  Command="{Binding ShowNewResourceDialogCommand}"/>
      <KeyBinding Gesture="Meta+I"
                  Command="{Binding RequestImportResourceFileCommand}"/>
      <KeyBinding Gesture="Meta+Shift+I"
                  Command="{Binding RequestImportResourceFolderCommand}"/>
      <KeyBinding Gesture="Meta+Delete"
                  Command="{Binding ShowDeleteSelectedResourceDialogCommand}"/>
      <KeyBinding Gesture="Meta+E"
                  Command="{Binding ShowPreviewExportDialogCommand}"/>
      <KeyBinding Gesture="Meta+Shift+E"
                  Command="{Binding RequestExportFileCommand}"/>
      <KeyBinding Gesture="Meta+B"
                  Command="{Binding ToggleProjectExplorerCommand}"/>
      <KeyBinding Gesture="Meta+W"
                  Command="{Binding CloseCurrentEditorCommand}"/>
      <KeyBinding Gesture="Meta+Shift+W"
                  Command="{Binding CloseAllEditorTabsCommand}"/>
      <KeyBinding Gesture="Meta+Tab"
                  Command="{Binding SelectNextEditorCommand}"/>
      <KeyBinding Gesture="Meta+Shift+Tab"
                  Command="{Binding SelectPreviousEditorCommand}"/>
      <KeyBinding Gesture="Meta+Alt+Left"
                  Command="{Binding MoveEditorLeftCommand}"
                  CommandParameter="{Binding SelectedEditor}"/>
      <KeyBinding Gesture="Meta+Alt+Right"
                  Command="{Binding MoveEditorRightCommand}"
                  CommandParameter="{Binding SelectedEditor}"/>
      <KeyBinding Gesture="Meta+Z"
                  Command="{Binding UndoSelectedEditorCommand}"/>
      <KeyBinding Gesture="Meta+Y"
                  Command="{Binding RedoSelectedEditorCommand}"/>
      <KeyBinding Gesture="Meta+Shift+Z"
                  Command="{Binding RedoSelectedEditorCommand}"/>
    </UserControl.KeyBindings>

    <Grid>
      <Grid RowDefinitions="34,*,28">
      <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,0,0,1">
        <Grid Margin="8,0"
              ColumnDefinitions="*">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
          <Menu Background="Transparent">
            <MenuItem Header="{DynamicResource Loc.Menu.Project}">
              <MenuItem Header="{DynamicResource Loc.Menu.NewProject}"
                        Command="{Binding ShowNewProjectDialogCommand}"
                        InputGesture="Meta+Shift+N"/>
              <MenuItem Header="{DynamicResource Loc.Menu.OpenProject}"
                        Command="{Binding ShowOpenProjectDialogCommand}"
                        InputGesture="Meta+O"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.SaveProject}"
                        Command="{Binding SaveProjectCommand}"
                        InputGesture="Meta+Alt+S"
                        IsEnabled="{Binding CanSaveCurrentProject}"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.ImportProjectZip}"
                        Click="ImportProjectMenuItem_Click"/>
              <MenuItem Header="{DynamicResource Loc.Menu.ExportProjectZip}"
                        Click="ExportProjectMenuItem_Click"
                        IsEnabled="{Binding CanSaveCurrentProject}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Resource}">
              <MenuItem Header="{DynamicResource Loc.Menu.NewResource}"
                        Command="{Binding ShowNewResourceDialogCommand}"
                        InputGesture="Meta+N"
                        IsEnabled="{Binding CanModifyCurrentProject}"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.ImportResourceFile}"
                        Click="ImportResourceFileMenuItem_Click"
                        InputGesture="Meta+I"
                        IsEnabled="{Binding CanModifyCurrentProject}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.ImportResourceFolder}"
                        Click="ImportFolderMenuItem_Click"
                        InputGesture="Meta+Shift+I"/>
              <MenuItem Header="{DynamicResource Loc.Menu.ImportResourcePak}"
                        Click="ImportPakMenuItem_Click"/>
              <MenuItem x:Name="RecentlyOpenedMenuItem"
                        Header="{DynamicResource Loc.Menu.RecentlyOpened}"
                        IsVisible="{Binding HasRecentlyOpenedProjectItems}"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.DeleteResource}"
                        Command="{Binding ShowDeleteSelectedResourceDialogCommand}"
                        InputGesture="Meta+Delete"
                        IsEnabled="{Binding CanDeleteSelectedResource}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Edit}">
              <MenuItem Header="{DynamicResource Loc.Menu.Undo}"
                        Command="{Binding UndoSelectedEditorCommand}"
                        InputGesture="Meta+Z"
                        IsEnabled="{Binding CanUndoSelectedEditor}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.Redo}"
                        Command="{Binding RedoSelectedEditorCommand}"
                        InputGesture="Meta+Y"
                        IsEnabled="{Binding CanRedoSelectedEditor}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.File}">
              <MenuItem Header="{DynamicResource Loc.Menu.SaveCurrentFile}"
                        Command="{Binding SaveFileCommand}"
                        InputGesture="Meta+S"
                        IsEnabled="{Binding CanSaveSelectedFile}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.SaveAllFiles}"
                        Command="{Binding SaveAllEditorsCommand}"
                        InputGesture="Meta+Shift+S"
                        IsEnabled="{Binding CanSaveAnyEditor}"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.ExportCurrentFile}"
                        Click="ExportFileMenuItem_Click"
                        InputGesture="Meta+Shift+E"
                        IsEnabled="{Binding CanExportSelectedFile}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.ExportPreview}"
                        Command="{Binding ShowPreviewExportDialogCommand}"
                        InputGesture="Meta+E"
                        IsEnabled="{Binding CanExportSelectedPreview}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Tabs}">
              <MenuItem Header="{DynamicResource Loc.Menu.PreviousTab}"
                        Command="{Binding SelectPreviousEditorCommand}"
                        InputGesture="Meta+Shift+Tab"
                        IsEnabled="{Binding CanSelectPreviousEditor}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.NextTab}"
                        Command="{Binding SelectNextEditorCommand}"
                        InputGesture="Meta+Tab"
                        IsEnabled="{Binding CanSelectNextEditor}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.MoveTabLeft}"
                        Command="{Binding MoveEditorLeftCommand}"
                        CommandParameter="{Binding SelectedEditor}"
                        InputGesture="Meta+Alt+Left"
                        IsEnabled="{Binding CanMoveSelectedEditorLeft}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.MoveTabRight}"
                        Command="{Binding MoveEditorRightCommand}"
                        CommandParameter="{Binding SelectedEditor}"
                        InputGesture="Meta+Alt+Right"
                        IsEnabled="{Binding CanMoveSelectedEditorRight}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.TogglePinTab}"
                        Command="{Binding ToggleEditorPinnedCommand}"
                        CommandParameter="{Binding SelectedEditor}"
                        IsEnabled="{Binding HasOpenEditors}"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.CloseCurrentTab}"
                        Command="{Binding CloseCurrentEditorCommand}"
                        InputGesture="Meta+W"
                        IsEnabled="{Binding CanCloseSelectedEditor}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.CloseOtherTabs}"
                        Command="{Binding CloseOtherEditorsCommand}"
                        CommandParameter="{Binding SelectedEditor}"
                        IsEnabled="{Binding CanCloseOtherEditors}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.CloseTabsToLeft}"
                        Command="{Binding CloseEditorsToLeftCommand}"
                        CommandParameter="{Binding SelectedEditor}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.CloseTabsToRight}"
                        Command="{Binding CloseEditorsToRightCommand}"
                        CommandParameter="{Binding SelectedEditor}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.CloseSavedTabs}"
                        Command="{Binding CloseSavedEditorsCommand}"
                        IsEnabled="{Binding CanCloseSavedEditors}"/>
              <MenuItem Header="{DynamicResource Loc.Menu.CloseAllTabs}"
                        Command="{Binding CloseAllEditorTabsCommand}"
                        InputGesture="Meta+Shift+W"
                        IsEnabled="{Binding HasClosableEditors}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.View}">
              <MenuItem Header="{DynamicResource Loc.Menu.ProjectExplorer}"
                        Command="{Binding ToggleProjectExplorerCommand}"
                        InputGesture="Meta+B"
                        IsChecked="{Binding IsProjectExplorerVisible, Mode=OneWay}"
                        ToggleType="CheckBox"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.DockExplorerLeft}"
                        Command="{Binding DockProjectExplorerLeftCommand}"
                        IsChecked="{Binding IsProjectExplorerDockedLeft, Mode=OneWay}"
                        ToggleType="Radio"/>
              <MenuItem Header="{DynamicResource Loc.Menu.DockExplorerRight}"
                        Command="{Binding DockProjectExplorerRightCommand}"
                        IsChecked="{Binding IsProjectExplorerDockedRight, Mode=OneWay}"
                        ToggleType="Radio"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Label.LightTheme}"
                        IsChecked="{Binding UseLightTheme, Mode=TwoWay}"
                        ToggleType="CheckBox"/>
              <MenuItem Header="{DynamicResource Loc.Label.DarkTheme}"
                        IsChecked="{Binding UseDarkTheme, Mode=TwoWay}"
                        ToggleType="CheckBox"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Label.LightViewportBackground}"
                        IsChecked="{Binding UseLightViewportBackground, Mode=TwoWay}"
                        ToggleType="CheckBox"/>
              <MenuItem Header="{DynamicResource Loc.Label.DarkViewportBackground}"
                        IsChecked="{Binding UseDarkViewportBackground, Mode=TwoWay}"
                        ToggleType="CheckBox"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.ResetLayout}"
                        Command="{Binding ResetLayoutCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Loc.Menu.Language}">
              <MenuItem Header="{DynamicResource Loc.Language.English}"
                        Command="{Binding SetEnglishLanguageCommand}"
                        IsChecked="{Binding IsEnglishLanguage, Mode=OneWay}"
                        ToggleType="Radio"/>
              <MenuItem Header="{DynamicResource Loc.Language.ChineseSimplified}"
                        Command="{Binding SetChineseLanguageCommand}"
                        IsChecked="{Binding IsChineseLanguage, Mode=OneWay}"
                        ToggleType="Radio"/>
              <Separator/>
              <MenuItem Header="{DynamicResource Loc.Menu.LoadLanguageFile}"
                        Click="LoadLanguageFileMenuItem_Click"/>
            </MenuItem>
          </Menu>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid x:Name="WorkspaceGrid"
            Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="0"/>
          <RowDefinition Height="0" MinHeight="0"/>
          <RowDefinition Height="0" MinHeight="0"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"
                            MinWidth="180"/>
          <ColumnDefinition Width="5"
                            MinWidth="5"/>
          <ColumnDefinition Width="*" MinWidth="320"/>
          <ColumnDefinition Width="0"
                            MinWidth="0"/>
          <ColumnDefinition Width="0"
                            MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="LeftProjectExplorerPanel"
                Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                IsVisible="{Binding IsProjectExplorerVisibleLeft}"
                Classes="project-explorer-panel"
                input:DragDrop.AllowDrop="True"
                input:DragDrop.DragOver="ProjectExplorer_DragOver"
                input:DragDrop.DragLeave="ProjectExplorer_DragLeave"
                input:DragDrop.Drop="ProjectExplorer_Drop">
          <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="8">
            <TextBlock Text="{DynamicResource Loc.Label.ProjectExplorer}"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
              <TextBox Text="{Binding ProjectTreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{DynamicResource Loc.Placeholder.SearchProjectTree}"
                       Classes="project-tree-search"/>
              <Button Grid.Column="1"
                      Content="x"
                      Width="30"
                      Padding="0"
                      ToolTip.Tip="{DynamicResource Loc.ProjectTree.ClearSearch}"
                      IsVisible="{Binding HasProjectTreeSearchText}"
                      Command="{Binding ClearProjectTreeSearchCommand}"/>
            </Grid>
            <Grid Grid.Row="2">
              <ListBox ItemsSource="{Binding VisibleProjectItems}"
                       SelectedItem="{Binding SelectedProjectItem}"
                       ItemTemplate="{StaticResource ProjectExplorerItemTemplate}"
                       SelectionMode="Single"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       IsVisible="{Binding HasVisibleProjectTreeItems}"
                       Classes="project-tree-list">
                <ListBox.KeyBindings>
                  <KeyBinding Gesture="Delete"
                              Command="{Binding ShowDeleteSelectedResourceDialogCommand}"/>
                </ListBox.KeyBindings>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock Text="{Binding ProjectTreeEmptyMessage}"
                         IsVisible="{Binding HasNoVisibleProjectTreeItems}"
                         Foreground="{DynamicResource TextControlPlaceholderForeground}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         Margin="12"/>
            </Grid>
          </Grid>
        </Border>

        <GridSplitter x:Name="LeftProjectExplorerSplitter"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      IsVisible="{Binding IsProjectExplorerVisibleLeft}"
                      Classes="layout-splitter vertical-splitter"/>

        <Grid x:Name="WorkspaceContentGrid"
              Grid.Column="2"
              RowDefinitions="42,*">
          <Border Background="{DynamicResource SystemControlBackgroundChromeLowBrush}"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="0,0,0,1">
            <Grid x:Name="DocumentTabHeaderGrid"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="8,0">
              <Button x:Name="CompactProjectExplorerButton"
                      Content="☰"
                      Classes.compact-project-explorer-button="True"
                      ToolTip.Tip="{DynamicResource Loc.Menu.ProjectExplorer}"
                      IsVisible="False"
                      Click="CompactProjectExplorerButton_Click"/>
              <ScrollViewer x:Name="DocumentTabStripScrollViewer"
                            Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled"
                            Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding OpenEditors}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:EditorViewModelBase">
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0"
                            Margin="0,6,6,0"
                            Padding="8,0"
                            MinWidth="150"
                            MaxWidth="320"
                            Height="34"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            Classes.document-tab="True"
                            Classes.selected="{Binding IsSelected}"
                            Classes.pinned="{Binding IsPinned}"
                            Classes.dragging="{Binding IsTabDragging}"
                            Classes.drop-before="{Binding IsTabDropBefore}"
                            Classes.drop-after="{Binding IsTabDropAfter}"
                            ToolTip.Tip="{Binding TabToolTip}"
                            PointerPressed="DocumentTab_PointerPressed"
                            PointerMoved="DocumentTab_PointerMoved"
                            PointerReleased="DocumentTab_PointerReleased"
                            PointerCaptureLost="DocumentTab_PointerCaptureLost">
                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{DynamicResource Loc.Menu.TogglePinTab}"
                                    Command="{Binding $parent[UserControl].DataContext.ToggleEditorPinnedCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="{DynamicResource Loc.Menu.MoveTabLeft}"
                                    Command="{Binding $parent[UserControl].DataContext.MoveEditorLeftCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="{DynamicResource Loc.Menu.MoveTabRight}"
                                    Command="{Binding $parent[UserControl].DataContext.MoveEditorRightCommand}"
                                    CommandParameter="{Binding}"/>
                          <Separator/>
                          <MenuItem Header="{DynamicResource Loc.Menu.CloseCurrentTab}"
                                    Command="{Binding $parent[UserControl].DataContext.CloseEditorCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="{DynamicResource Loc.Menu.CloseOtherTabs}"
                                    Command="{Binding $parent[UserControl].DataContext.CloseOtherEditorsCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="{DynamicResource Loc.Menu.CloseTabsToLeft}"
                                    Command="{Binding $parent[UserControl].DataContext.CloseEditorsToLeftCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="{DynamicResource Loc.Menu.CloseTabsToRight}"
                                    Command="{Binding $parent[UserControl].DataContext.CloseEditorsToRightCommand}"
                                    CommandParameter="{Binding}"/>
                          <MenuItem Header="{DynamicResource Loc.Menu.CloseSavedTabs}"
                                    Command="{Binding $parent[UserControl].DataContext.CloseSavedEditorsCommand}"/>
                        </ContextMenu>
                      </Border.ContextMenu>
                      <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="x"
                                Classes.tab-close-button="True"
                                Margin="8,0,0,0"
                                IsVisible="{Binding CanClose}"
                                ToolTip.Tip="{DynamicResource Loc.Document.CloseTab}"
                                Command="{Binding $parent[UserControl].DataContext.CloseEditorCommand}"
                                CommandParameter="{Binding}"/>
                        <Grid ColumnDefinitions="Auto,Auto,*"
                              VerticalAlignment="Center">
                          <Border Classes="tab-kind-badge"
                                  Margin="0,0,6,0">
                            <TextBlock Text="{Binding KindCode}"
                                       Classes="tab-kind-badge-text"/>
                          </Border>
                          <Border Grid.Column="1"
                                  Classes="tab-pin-badge"
                                  Margin="0,0,6,0"
                                  IsVisible="{Binding IsPinned}">
                            <TextBlock Text="PIN"
                                       Classes="tab-pin-badge-text"/>
                          </Border>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding TabTitle}"
                                     Classes.document-tab-title="True"
                                     Classes.selected="{Binding IsSelected}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>

              <Menu Grid.Column="2"
                    Background="Transparent"
                    VerticalAlignment="Center">
                <MenuItem Header="..."
                          ToolTip.Tip="{DynamicResource Loc.Document.MoreTabs}">
                  <MenuItem Header="{DynamicResource Loc.Menu.SaveAllFiles}"
                            Command="{Binding SaveAllEditorsCommand}"
                            IsEnabled="{Binding CanSaveAnyEditor}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.ExportPreview}"
                            Command="{Binding ShowPreviewExportDialogCommand}"
                            IsEnabled="{Binding CanExportSelectedPreview}"/>
                  <Separator/>
                  <MenuItem Header="{DynamicResource Loc.Menu.PreviousTab}"
                            Command="{Binding SelectPreviousEditorCommand}"
                            IsEnabled="{Binding CanSelectPreviousEditor}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.NextTab}"
                            Command="{Binding SelectNextEditorCommand}"
                            IsEnabled="{Binding CanSelectNextEditor}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.MoveTabLeft}"
                            Command="{Binding MoveEditorLeftCommand}"
                            CommandParameter="{Binding SelectedEditor}"
                            IsEnabled="{Binding CanMoveSelectedEditorLeft}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.MoveTabRight}"
                            Command="{Binding MoveEditorRightCommand}"
                            CommandParameter="{Binding SelectedEditor}"
                            IsEnabled="{Binding CanMoveSelectedEditorRight}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.TogglePinTab}"
                            Command="{Binding ToggleEditorPinnedCommand}"
                            CommandParameter="{Binding SelectedEditor}"
                            IsEnabled="{Binding HasOpenEditors}"/>
                  <Separator/>
                  <MenuItem Header="{DynamicResource Loc.Menu.CloseCurrentTab}"
                            Command="{Binding CloseCurrentEditorCommand}"
                            IsEnabled="{Binding CanCloseSelectedEditor}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.CloseOtherTabs}"
                            Command="{Binding CloseOtherEditorsCommand}"
                            CommandParameter="{Binding SelectedEditor}"
                            IsEnabled="{Binding CanCloseOtherEditors}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.CloseSavedTabs}"
                            Command="{Binding CloseSavedEditorsCommand}"
                            IsEnabled="{Binding CanCloseSavedEditors}"/>
                  <MenuItem Header="{DynamicResource Loc.Menu.CloseAllTabs}"
                            Command="{Binding CloseAllEditorTabsCommand}"
                            IsEnabled="{Binding HasClosableEditors}"/>
                </MenuItem>
              </Menu>
            </Grid>
          </Border>

          <ContentControl Grid.Row="1"
                          Content="{Binding SelectedEditor}"/>
        </Grid>

        <GridSplitter x:Name="RightProjectExplorerSplitter"
                      Grid.Column="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Columns"
                      IsVisible="{Binding IsProjectExplorerVisibleRight}"
                      Classes="layout-splitter vertical-splitter"/>

        <Border x:Name="RightProjectExplorerPanel"
                Grid.Column="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,0,0,0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                IsVisible="{Binding IsProjectExplorerVisibleRight}"
                Classes="project-explorer-panel"
                input:DragDrop.AllowDrop="True"
                input:DragDrop.DragOver="ProjectExplorer_DragOver"
                input:DragDrop.DragLeave="ProjectExplorer_DragLeave"
                input:DragDrop.Drop="ProjectExplorer_Drop">
          <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="8">
            <TextBlock Text="{DynamicResource Loc.Label.ProjectExplorer}"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="6">
              <TextBox Text="{Binding ProjectTreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="{DynamicResource Loc.Placeholder.SearchProjectTree}"
                       Classes="project-tree-search"/>
              <Button Grid.Column="1"
                      Content="x"
                      Width="30"
                      Padding="0"
                      ToolTip.Tip="{DynamicResource Loc.ProjectTree.ClearSearch}"
                      IsVisible="{Binding HasProjectTreeSearchText}"
                      Command="{Binding ClearProjectTreeSearchCommand}"/>
            </Grid>
            <Grid Grid.Row="2">
              <ListBox ItemsSource="{Binding VisibleProjectItems}"
                       SelectedItem="{Binding SelectedProjectItem}"
                       ItemTemplate="{StaticResource ProjectExplorerItemTemplate}"
                       SelectionMode="Single"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       IsVisible="{Binding HasVisibleProjectTreeItems}"
                       Classes="project-tree-list">
                <ListBox.KeyBindings>
                  <KeyBinding Gesture="Delete"
                              Command="{Binding ShowDeleteSelectedResourceDialogCommand}"/>
                </ListBox.KeyBindings>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock Text="{Binding ProjectTreeEmptyMessage}"
                         IsVisible="{Binding HasNoVisibleProjectTreeItems}"
                         Foreground="{DynamicResource TextControlPlaceholderForeground}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         TextAlignment="Center"
                         Margin="12"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock Text="{Binding StatusText}"
                   Margin="12,0"
                   VerticalAlignment="Center"/>
      </Border>
      </Grid>

    <Canvas IsHitTestVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Border x:Name="DocumentTabDragPreview"
              Classes="document-tab-preview"
              IsVisible="False"
              Height="34"
              MinWidth="150"
              MaxWidth="320">
        <Grid ColumnDefinitions="Auto,Auto,*"
              VerticalAlignment="Center">
          <Border Classes="tab-kind-badge"
                  Margin="0,0,6,0">
            <TextBlock x:Name="DocumentTabDragPreviewKind"
                       Classes="tab-kind-badge-text"/>
          </Border>
          <Border x:Name="DocumentTabDragPreviewPin"
                  Grid.Column="1"
                  Classes="tab-pin-badge"
                  Margin="0,0,6,0">
            <TextBlock Text="PIN"
                       Classes="tab-pin-badge-text"/>
          </Border>
          <TextBlock x:Name="DocumentTabDragPreviewTitle"
                     Grid.Column="2"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"/>
        </Grid>
      </Border>
    </Canvas>

      <Border Background="#80000000"
            IsVisible="{Binding IsUnsavedChangesPromptOpen}">
      <Border MaxWidth="420"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding UnsavedChangesTitle}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding UnsavedChangesMessage}"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource Loc.Dialog.SaveChangesBeforeContinuing}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Save}"
                    MinWidth="80"
                    Command="{Binding SaveUnsavedChangesCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Discard}"
                    MinWidth="80"
                    Command="{Binding DiscardUnsavedChangesCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelUnsavedChangesCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsOpenProjectDialogOpen}">
      <Border MaxWidth="520"
              MaxHeight="520"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <TextBlock Text="{DynamicResource Loc.Dialog.OpenProject}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1"
                     Text="{Binding OpenProjectMessage}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
          <Border Grid.Row="2"
                  MinHeight="180"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding HasAvailableProjects}">
            <ListBox ItemsSource="{Binding AvailableProjects}"
                     SelectedItem="{Binding SelectedAvailableProject}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ProjectListItemViewModel">
                  <Grid ColumnDefinitions="*,Auto,Auto"
                        RowDefinitions="Auto,Auto"
                        Margin="8,6">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding DirectoryName}"
                               FontSize="12"
                               Foreground="{DynamicResource TextControlPlaceholderForeground}"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1"
                            Grid.RowSpan="2"
                            Content="{DynamicResource Loc.Common.Rename}"
                            MinWidth="72"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].DataContext.ShowRenameProjectDialogCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Grid.Column="2"
                            Grid.RowSpan="2"
                            Content="{DynamicResource Loc.Common.Delete}"
                            MinWidth="72"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[UserControl].DataContext.ShowDeleteProjectDialogCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <StackPanel Grid.Row="3"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Open}"
                    MinWidth="80"
                    Command="{Binding OpenSelectedProjectCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelOpenProjectCommand}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsRenameProjectDialogOpen}">
      <Border MaxWidth="420"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource Loc.Dialog.RenameProject}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.Name}"/>
            <TextBox Text="{Binding RenameProjectName, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Rename}"
                    MinWidth="80"
                    Command="{Binding RenameProjectCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelRenameProjectCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsPreviewExportDialogOpen}">
      <Border MaxWidth="460"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource Loc.Dialog.ExportPreview}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource Loc.Dialog.ExportPreviewMessage}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="8">
            <TextBlock Text="{DynamicResource Loc.Label.Format}"
                       VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding PreviewExportFormats}"
                      SelectedItem="{Binding PreviewExportFormat}"
                      HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource Loc.Label.Timeline}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasPreviewExportTimelineOptions}"/>
            <ComboBox Grid.Row="1"
                      Grid.Column="1"
                      ItemsSource="{Binding PreviewExportTimelines}"
                      SelectedItem="{Binding SelectedPreviewExportTimeline}"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding HasPreviewExportTimelineOptions}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:PreviewExportTimelineOption">
                  <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="2"
                       Text="{DynamicResource Loc.Label.StartFrame}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasPreviewExportFrameRangeOptions}"/>
            <NumericUpDown Grid.Row="2"
                           Grid.Column="1"
                           Value="{Binding PreviewExportStartFrame}"
                           Minimum="1"
                           Maximum="{Binding PreviewExportFrameRangeMaximum}"
                           Increment="1"
                           FormatString="0"
                           IsVisible="{Binding HasPreviewExportFrameRangeOptions}"/>
            <TextBlock Grid.Row="2"
                       Text="{DynamicResource Loc.Label.StartSecond}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasPreviewExportTimeRangeOptions}"/>
            <NumericUpDown Grid.Row="2"
                           Grid.Column="1"
                           Value="{Binding PreviewExportStartSeconds}"
                           Minimum="0"
                           Maximum="200"
                           Increment="0.1"
                           FormatString="0.###"
                           IsVisible="{Binding HasPreviewExportTimeRangeOptions}"/>

            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Loc.Label.EndFrame}"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding IsPreviewExportEndFrameEditable}"
                       IsVisible="{Binding HasPreviewExportFrameRangeOptions}"/>
            <NumericUpDown Grid.Row="3"
                           Grid.Column="1"
                           Value="{Binding PreviewExportEndFrame}"
                           Minimum="1"
                           Maximum="{Binding PreviewExportFrameRangeMaximum}"
                           Increment="1"
                           FormatString="0"
                           IsEnabled="{Binding IsPreviewExportEndFrameEditable}"
                           IsVisible="{Binding HasPreviewExportFrameRangeOptions}"/>
            <TextBlock Grid.Row="3"
                       Text="{DynamicResource Loc.Label.EndSecond}"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding IsPreviewExportEndSecondsEditable}"
                       IsVisible="{Binding HasPreviewExportTimeRangeOptions}"/>
            <NumericUpDown Grid.Row="3"
                           Grid.Column="1"
                           Value="{Binding PreviewExportEndSeconds}"
                           Minimum="0"
                           Maximum="200"
                           Increment="0.1"
                           FormatString="0.###"
                           IsEnabled="{Binding IsPreviewExportEndSecondsEditable}"
                           IsVisible="{Binding HasPreviewExportTimeRangeOptions}"/>

            <CheckBox Grid.Row="4"
                      Grid.Column="1"
                      Content="{DynamicResource Loc.Label.ExportToEnd}"
                      IsChecked="{Binding PreviewExportUntilEnd}"
                      IsEnabled="{Binding IsPreviewExportUntilEndEditable}"
                      IsVisible="{Binding HasPreviewExportTimeRangeOptions}"/>

            <TextBlock Grid.Row="5"
                       Text="{DynamicResource Loc.Label.CanvasScale}"
                       VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="5"
                           Grid.Column="1"
                           Value="{Binding PreviewExportCanvasScale}"
                           Minimum="0.1"
                           Maximum="16"
                           Increment="0.25"
                           FormatString="0.##"/>

            <TextBlock Grid.Row="6"
                       Text="{DynamicResource Loc.Label.FPS}"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding IsPreviewAnimationExport}"/>
            <NumericUpDown Grid.Row="6"
                           Grid.Column="1"
                           Value="{Binding PreviewExportFps}"
                           Minimum="1"
                           Maximum="240"
                           Increment="1"
                           FormatString="0"
                           IsEnabled="{Binding IsPreviewAnimationExport}"/>

            <TextBlock Grid.Row="7"
                       Text="{DynamicResource Loc.Label.Duration}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsPreviewExportDurationVisible}"/>
            <NumericUpDown Grid.Row="7"
                           Grid.Column="1"
                           Value="{Binding PreviewExportDurationSeconds}"
                           Minimum="0.01"
                           Maximum="600"
                           Increment="0.25"
                           FormatString="0.##"
                           IsVisible="{Binding IsPreviewExportDurationVisible}"/>
          </Grid>
          <TextBlock Text="{Binding PreviewExportFrameCountSummary}"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"
                     IsVisible="{Binding IsPreviewAnimationExport}"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Export}"
                    MinWidth="80"
                    Command="{Binding RequestPreviewExportCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelPreviewExportCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsDeleteProjectDialogOpen}">
      <Border MaxWidth="460"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource Loc.Dialog.DeleteProject}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DeleteProjectMessage}"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource Loc.Dialog.DeleteProjectWarning}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Delete}"
                    MinWidth="80"
                    Command="{Binding DeleteProjectCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelDeleteProjectCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsDeleteResourceDialogOpen}">
      <Border MaxWidth="460"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource Loc.Dialog.DeleteResource}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DeleteResourceMessage}"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{DynamicResource Loc.Dialog.DeleteResourceWarning}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Delete}"
                    MinWidth="80"
                    Command="{Binding DeleteResourceCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelDeleteResourceCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsNewProjectDialogOpen}">
      <Border MaxWidth="420"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource Loc.Dialog.NewProject}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.Name}"/>
            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Create}"
                    MinWidth="80"
                    Command="{Binding CreateProjectCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelNewProjectCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsNewResourceDialogOpen}">
      <Border MaxWidth="440"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{DynamicResource Loc.Dialog.NewResource}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.Type}"/>
            <ComboBox ItemsSource="{Binding NewResourceKinds}"
                      SelectedItem="{Binding NewResourceKind}"
                      HorizontalAlignment="Stretch"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="{DynamicResource Loc.Label.ID}"/>
            <TextBox Text="{Binding NewResourceId, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="{DynamicResource Loc.Common.Create}"
                    MinWidth="80"
                    Command="{Binding CreateResourceCommand}"/>
            <Button Content="{DynamicResource Loc.Common.Cancel}"
                    MinWidth="80"
                    Command="{Binding CancelNewResourceCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Background="#80000000"
            IsVisible="{Binding IsProjectTransferInProgress}">
      <Border MaxWidth="460"
              Margin="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ProjectTransferTitle}"
                     FontSize="18"
                     FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ProjectTransferMessage}"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
          <ProgressBar Minimum="0"
                       Maximum="100"
                       Height="8"
                       IsIndeterminate="{Binding IsProjectTransferProgressIndeterminate}"
                       Value="{Binding ProjectTransferProgressValue}"/>
          <TextBlock Text="{Binding ProjectTransferProgressText}"
                     HorizontalAlignment="Right"
                     FontSize="12"
                     Foreground="{DynamicResource TextControlPlaceholderForeground}"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
