<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Resolve GLES entry points in the same Emscripten module as Skia. -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- Recorded operations and resource disposal currently share the browser UI thread. -->
    <WasmEnableThreads>false</WasmEnableThreads>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -s FULL_ES3=1 -s MIN_WEBGL_VERSION=2 -s MAX_WEBGL_VERSION=2</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="MoonSharp.Interpreter" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EffectViewer\EffectViewer.csproj" />
  </ItemGroup>
</Project>
